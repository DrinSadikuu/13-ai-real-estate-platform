from uuid import UUID

from fastapi import APIRouter, Depends
from sqlalchemy.ext.asyncio import AsyncSession

from app.db.database import get_db
from app.schemas.viewing import ViewingCreate, ViewingResponse, ViewingUpdate
from app.services.viewing_service import ViewingService

router = APIRouter(
    prefix="/viewings",
    tags=["viewings"],
)

@router.post(
    "",
    response_model=ViewingResponse,
    status_code=201,
)
async def create_viewing(
    data: ViewingCreate,
    session: AsyncSession = Depends(get_db),
):
    service = ViewingService(session)
    return await service.create_viewing(data)


@router.get(
    "",
    response_model=list[ViewingResponse],
)
async def get_viewings(
    client_id: UUID | None = None,
    property_id: UUID | None = None,
    session: AsyncSession = Depends(get_db),
):
    service = ViewingService(session)

    return await service.get_viewings(
        client_id=client_id,
        property_id=property_id,
    )


@router.get("/{viewing_id}", response_model=ViewingResponse)
async def get_viewing_by_id(viewing_id: UUID, session: AsyncSession = Depends(get_db)):
    service = ViewingService(session)
    return await service.get_viewing_by_id(viewing_id)


@router.patch(
    "/{viewing_id}",
    response_model=ViewingResponse,
)
async def update_viewing(
    viewing_id: UUID,
    data: ViewingUpdate,
    session: AsyncSession = Depends(get_db),
):
    service = ViewingService(session)

    viewing = await service.get_viewing_by_id(viewing_id)

    return await service.update_viewing(
        viewing,
        data,
    )