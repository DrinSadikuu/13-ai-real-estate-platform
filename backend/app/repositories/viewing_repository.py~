from uuid import UUID

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.models.viewing import Viewing
from app.schemas.viewing import ViewingCreate, ViewingUpdate


class ViewingRepository:
    def __init__(self, session: AsyncSession):
        self.session = session

    async def create(self, data: ViewingCreate) -> Viewing:
        viewing = Viewing(
            **data.model_dump()
        )
        self.session.add(viewing)

        await self.session.commit()
        await self.session.refresh(viewing)

        return viewing

    async def get_all(
            self,
            client_id: UUID | None = None,
            property_id: UUID | None = None,
    ) -> list[Viewing]:
        query = select(Viewing)

        if client_id is not None:
            query = query.where(Viewing.client_id == client_id)

        if property_id is not None:
            query = query.where(Viewing.property_id == property_id)

        result = await self.session.execute(query)

        return list(result.scalars().all())

    async def get_by_id(self, viewing_id: UUID) -> Viewing | None:
        result = await self.session.execute(
            select(Viewing).where(
                Viewing.id == viewing_id
            )
        )
        return result.scalar_one_or_none()

    async def update(self, viewing: Viewing, data: ViewingUpdate) -> Viewing:
        update_data = data.model_dump(exclude_unset=True)

        for field, value in update_data.items():
            setattr(viewing, field, value)

        await self.session.commit()
        await self.session.refresh(viewing)

        return viewing

